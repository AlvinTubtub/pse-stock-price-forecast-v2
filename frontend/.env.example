# ==============================================================================
# ForecastPH V2 — Environment Variables Configuration Template
# Copy this file to .env.local for local development.
# Configure these variables in Vercel Project Settings for production deployment.
# ==============================================================================

# 1. Persistent Database (Neon PostgreSQL)
# Durable source of truth for Admin configuration, audit trail, and pipeline execution metadata.
# Create a free project at https://neon.tech/ and paste the pooled connection string here:
DATABASE_URL=postgresql://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 2. Administrative Authentication & Testing Credentials
# Current Testing Credentials (DO NOT CHANGE during Capstone Phase):
# Usernames: admin1, admin2, admin3, admin4
# Password: capstone2
ADMIN_USERNAME_1=admin1
ADMIN_USERNAME_2=admin2
ADMIN_USERNAME_3=admin3
ADMIN_USERNAME_4=admin4
ADMIN_PASSWORD=capstone2

# Cryptographic salt secret for signing session tokens (generate a random 32+ char string in production)
ADMIN_SESSION_SECRET=forecastph-v2-capstone-testing-hmac-secret-salt

# 3. GitHub Actions Pipeline Dispatch & Workflow Tracking
# Create a GitHub Fine-grained PAT with 'Actions: Read and write' permissions on AlvinTubtub/pse-stock-price-forecast-v2
GITHUB_ACTION_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_REPOSITORY_OWNER=AlvinTubtub
GITHUB_REPOSITORY_NAME=pse-stock-price-forecast-v2

# 4. Google Gemini AI Assistant
# Obtain API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
